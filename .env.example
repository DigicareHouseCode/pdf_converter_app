# Flask Configuration
SECRET_KEY=change-me
FLASK_APP=app.py
FLASK_DEBUG=False

# Database Configuration
# Either provide the full DATABASE_URL...
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/pdf_converter

# ...or the individual components (recommended for VPS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pdf_converter

# Gemini API Configuration
GEMINI_API_KEY=

# Tesseract Path (for Linux/VPS - leave blank to use system path)
# TESSERACT_CMD=/usr/bin/tesseract

# Stripe Credentials
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Credentials
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
