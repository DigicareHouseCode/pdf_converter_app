# Flask Configuration
SECRET_KEY=change-me-to-a-long-random-string
FLASK_APP=app.py
FLASK_DEBUG=False

# Database Configuration
# Either provide the full DATABASE_URL...
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/pdf_converter

# ...or the individual components (recommended for VPS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pdf_converter

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-pro

# Extraction tuning
# 300 DPI is the floor for reliable OCR of financial documents.
EXTRACTION_DPI=300
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=8192
# Pages read concurrently. Raise only if your Gemini quota allows.
EXTRACTION_WORKERS=3
# Cost ceiling: each page is one vision call.
MAX_PAGES_PER_CONVERSION=200

# Check extraction mode. The upload flow is built; the extractor is not, so
# this stays false until it ships. Set true to preview the upload UI.
CHECKS_ENABLED=true
# Most check images accepted in one batch.
MAX_CHECK_FILES=300
# Converted workbooks are deleted after this many hours.
OUTPUT_RETENTION_HOURS=48

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin account. Both must be set for one to be created; minimum 12 characters.
# Leave blank in production unless you need a password login for an operator.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Rate limiting. Defaults to per-process memory; set a Redis URL to share
# limits across Gunicorn workers, e.g. redis://localhost:6379/0
RATELIMIT_STORAGE_URI=

# Background retention/cleanup thread. Leave true in production.
ENABLE_MAINTENANCE=true

# Logging
LOG_LEVEL=INFO

# Tesseract Path (for Linux/VPS - leave blank to use system path)
# TESSERACT_CMD=/usr/bin/tesseract

# Stripe Credentials
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Credentials
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
